{
  "name": "hamad-cfa-mastery-path",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vinext build && node scripts/finalize-sites-build.mjs",
    "build:pages": "npm run typecheck && vite build --config vite.pages.config.mjs && node scripts/finalize-pages-build.mjs && node scripts/verify-private-tutor-content.mjs dist-pages",
    "preview": "vinext start",
    "preview:pages": "vite preview --config vite.pages.config.mjs --outDir dist-pages",
    "readings:integrate": "node scripts/integrate-readings.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-rsc": "^0.5.32",
    "firebase": "^12.17.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "^3.10.1",
    "vinext": "^1.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
