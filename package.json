{
  "name": "hamad-cfa-mastery-path",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.pages.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:pages",
    "build:pages": "npm run typecheck && vite build --config vite.pages.config.mjs && node scripts/finalize-pages-build.mjs && node scripts/verify-private-tutor-content.mjs dist-pages",
    "firestore:rules:deploy": "node scripts/deploy-firestore-rules.mjs",
    "firestore:rules:test": "node scripts/test-firestore-live-rules.mjs",
    "preview": "npm run preview:pages",
    "preview:pages": "vite preview --config vite.pages.config.mjs --outDir dist-pages",
    "readings:integrate": "node scripts/integrate-readings.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "react-test-renderer": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
